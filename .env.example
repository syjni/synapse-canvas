# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 git에 올라가지 않습니다)
# 비워 두면 동기화 없이(기기 저장만) 동작합니다.

# Supabase 대시보드 > Project Settings > API (또는 Connect)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile 사이트 키 (Supabase CAPTCHA를 켰을 때만)
VITE_TURNSTILE_SITE_KEY=

# 배포 사이트(Cloudflare Pages)는 이 파일이 아니라 Pages 프로젝트의 환경 변수를 씁니다 (DEPLOY.md 4·5단계)
